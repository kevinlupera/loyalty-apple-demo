# --- Identificadores del pase ---
# CAMBIAR al tener membresía Apple: valores reales del portal Developer.
PASS_TYPE_IDENTIFIER=pass.com.example.loyalty
PASS_TEAM_IDENTIFIER=DEV0000000
PASS_ORG_NAME=Mi Tienda

# --- Certificados ---
# DEV: generados por `npm run certs:dev` (self-signed, NO instalables en iPhone real).
# PROD: reemplazar por los reales de Apple (Pass Type ID cert + key + WWDR).
WALLET_SIGNER_CERT=certs/signerCert.pem
WALLET_SIGNER_KEY=certs/signerKey.pem
WALLET_SIGNER_KEY_PASSPHRASE=dev-passphrase
WALLET_WWDR_CERT=certs/wwdr.pem

# --- Estilo (hex o rgb()) ---
PASS_BG_COLOR=rgb(30,30,40)
PASS_FG_COLOR=rgb(255,255,255)
PASS_LABEL_COLOR=rgb(180,180,190)
